rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Users
    // ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // ─────────────────────────────────────────────────────────────
    // Competitions (and all subcollections)
    // ─────────────────────────────────────────────────────────────
    match /competitions/{competitionId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      // Categories
      match /categories/{categoryId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();

        // Matches — Scoreboard Controller can update score/timer fields
        match /matches/{matchId} {
          allow read: if request.auth != null;
          allow create: if isAdmin();
          allow update: if isAdmin() || isScoreboardController();
          allow delete: if isAdmin();
        }
      }

      // Athletes — Attendance Volunteer can update attendance/readiness/disqualified
      match /athletes/{athleteId} {
        allow read: if request.auth != null;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || isAttendanceVolunteer();
      }

      // Medals — Medal Distributor can toggle 'received' field only
      match /medals/{medalistId} {
        allow read: if request.auth != null;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || isMedalDistributor();
      }

      // Staff assignments — Admin only
      match /staff/{assignmentId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }

      // Mats — Admin only (includes password field)
      match /mats/{matId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }

      // Schedule — Admin only
      match /schedule/{rowId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────────────────────────
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'Admin';
    }

    function isScoreboardController() {
      return request.auth != null && getUserRole() == 'Scoreboard Controller';
    }

    function isAttendanceVolunteer() {
      return request.auth != null && getUserRole() == 'Attendance Volunteer';
    }

    function isMedalDistributor() {
      return request.auth != null && getUserRole() == 'Medal Distributor';
    }
  }
}
