rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Users
    // ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // ─────────────────────────────────────────────────────────────
    // Competitions (and all subcollections)
    // ─────────────────────────────────────────────────────────────
    match /competitions/{competitionId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      // Categories
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin();

        // Matches — Mat Operator can update score/timer fields
        match /matches/{matchId} {
          allow read: if true;
          allow create: if isAdmin();
          allow update: if isAdmin() || isMatOperator();
          allow delete: if isAdmin();
        }
      }

      // Athletes — Attendance Volunteer can update attendance/readiness/disqualified
      match /athletes/{athleteId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || isAttendanceVolunteer();
      }

      // Medals — Medal Distributor can toggle 'received' field only
      match /medals/{medalistId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || isMedalDistributor();
      }

      // Staff assignments — Admin can manage; Authenticated users can request access
      match /staff/{assignmentId} {
        allow read: if true;
        allow create: if isAdmin() || (
          request.auth != null && 
          request.resource.data.approvalStatus == 'pending'
        );
        allow update: if isAdmin() || (
          request.auth != null && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'requestUserId', 'requestTimestamp']) &&
          request.resource.data.approvalStatus == 'pending'
        );
        allow delete: if isAdmin();
      }

      // Mats — Admin only (includes password field)
      match /mats/{matId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Schedule — Admin only
      match /schedule/{rowId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Drafts Setup / Config
      match /drafts/{draftId} {
        allow read: if isAdmin();
        allow write: if request.auth != null && (getUserRole() == 'admin' || getUserRole() == 'Admin');
      }
    }

    // ─────────────────────────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────────────────────────
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && (getUserRole() == 'admin' || getUserRole() == 'Admin' || getUserRole() == 'guest_viewer' || getUserRole() == 'Guest Viewer');
    }

    function isMatOperator() {
      return request.auth != null && (getUserRole() == 'mat_operator' || getUserRole() == 'Mat Operator');
    }

    function isAttendanceVolunteer() {
      return request.auth != null && (getUserRole() == 'attendance_volunteer' || getUserRole() == 'Attendance Volunteer');
    }

    function isMedalDistributor() {
      return request.auth != null && (getUserRole() == 'medal_distributor' || getUserRole() == 'Medal Distributor');
    }
  }
}
