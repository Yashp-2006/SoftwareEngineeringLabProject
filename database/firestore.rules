rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────────────────────────
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && (getUserRole() == 'admin' || getUserRole() == 'Admin' || getUserRole() == 'guest_viewer' || getUserRole() == 'Guest Viewer');
    }

    function isMatOperator() {
      return request.auth != null && (getUserRole() == 'mat_operator' || getUserRole() == 'Mat Operator');
    }

    function isAttendanceVolunteer() {
      return request.auth != null && (getUserRole() == 'attendance_volunteer' || getUserRole() == 'Attendance Volunteer');
    }

    function isMedalDistributor() {
      return request.auth != null && (getUserRole() == 'medal_distributor' || getUserRole() == 'Medal Distributor');
    }

    // ─────────────────────────────────────────────────────────────
    // Users
    // ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Prevent users from granting themselves admin roles on creation
      allow create: if request.auth != null && (request.auth.uid == uid || isAdmin()) && (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role == 'user');
      // Prevent privilege escalation by blocking edits to the 'role' field
      allow update: if request.auth != null && (
        isAdmin() || 
        (request.auth.uid == uid && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Competitions (and all subcollections)
    // ─────────────────────────────────────────────────────────────
    match /competitions/{competitionId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      // Categories
      match /categories/{categoryId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          (isMatOperator() || isAttendanceVolunteer() || isMedalDistributor()) &&
          // Prevent tampering with fundamental config fields
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'competitionId']))
        );

        // Matches — Mat Operator can only update score/timer/status fields
        match /matches/{matchId} {
          allow read: if true;
          allow create: if isAdmin();
          allow update: if isAdmin() || (
            isMatOperator() && 
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['akaScore', 'aoScore', 'winnerId', 'status', 'kataVotes', 'selectedKata'])
          );
          allow delete: if isAdmin();
        }
      }

      // Athletes — Attendance Volunteer can only update check-in statuses
      match /athletes/{athleteId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          isAttendanceVolunteer() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance', 'readiness', 'disqualified', 'weighInStatus'])
        );
      }

      // Medals — Medal Distributor can only toggle 'received' field
      match /medals/{medalistId} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (
          isMedalDistributor() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['received'])
        );
      }

      // Staff assignments
      match /staff/{assignmentId} {
        allow read: if true;
        allow create: if isAdmin() || (
          request.auth != null && 
          request.resource.data.approvalStatus == 'pending' &&
          request.resource.data.requestUserId == request.auth.uid
        );
        // Prevent hijacking: allow state change from 'unassigned' to 'pending' only.
        allow update: if isAdmin() || (
          request.auth != null && 
          resource.data.approvalStatus == 'unassigned' && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'requestUserId', 'requestTimestamp']) &&
          request.resource.data.approvalStatus == 'pending' &&
          request.resource.data.requestUserId == request.auth.uid
        );
        allow delete: if isAdmin();
      }

      // Mats — Admin only
      match /mats/{matId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Schedule — Admin only
      match /schedule/{rowId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Drafts Setup / Config
      match /drafts/{draftId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }
  }
}
