# --- Firebase Client SDK (NEXT_PUBLIC_ = safe for browser) ---
# Firebase API keys are NOT secret - they identify your app but access is
# controlled by Firebase Security Rules and Authentication settings.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# --- Firebase Admin SDK (SERVER-ONLY - NEVER use NEXT_PUBLIC_ prefix) ---
# These give full admin access to your Firebase project. Keep strictly server-side.
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Upstash Redis (SERVER-ONLY) ---
# Rate limiting. Create a free database at https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# --- Algolia Search (partial client exposure) ---
# NEXT_PUBLIC_ALGOLIA_APP_ID: safe to expose (identifies app only)
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY: safe to expose ONLY if this is the search-only key
#   (NEVER use Admin API Key here - it has full read/write access)
# ALGOLIA_ADMIN_KEY: SERVER-ONLY - never expose to client
NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_search_only_key_here
ALGOLIA_ADMIN_KEY=your_admin_api_key_here
